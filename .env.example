# PostgreSQL
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SCORING_TOPIC=scoring

# CSV с размеченными транзакциями. Файл монтируется в data_loader и transaction_simulator.
TRAIN_DATA_CSV="/path/to/train.csv"

# Monitoring (local educational credentials; Grafana SQL role has SELECT only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_grafana_admin
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=local_grafana_ro
SEND_INTERVAL_SECONDS=0.5
